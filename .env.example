# ==============================================================================
# PayGate Backend Environment Variables
# ==============================================================================

# Application Port & Node Environment
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL 15+)
# ------------------------------------------------------------------------------
# Option 1: Local Docker Setup (from compose.yaml: postgres_db container)
DATABASE_URL=postgresql://db_user:db_password@localhost:5432/my_database

# Option 2: Remote / Cloud Setup (e.g. Neon PostgreSQL with SSL)
# DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<dbname>?sslmode=require

# ------------------------------------------------------------------------------
# Redis & BullMQ Configuration (Redis 7+)
# ------------------------------------------------------------------------------
# Option 1: Local Docker Setup (from compose.yaml: redis_cache container)
REDIS_URL=redis://localhost:6379

# Option 2: Remote / Cloud Redis (e.g. Render, Upstash, AWS ElastiCache)
# REDIS_URL=redis://red-placeholder:6379

# ------------------------------------------------------------------------------
# Worker Process Architecture Flag
# ------------------------------------------------------------------------------
# When set to true, BullMQ workers (inbound stripe, outbound webhooks) run
# directly inside the main Express process. Zero paid worker node required!
RUN_WORKERS_IN_PROCESS=true

# ------------------------------------------------------------------------------
# JWT Authentication & Cookie Secrets
# ------------------------------------------------------------------------------
ACCESS_TOKEN_SECRET=paygate-access-token-secret-example-change-in-prod
ACCESS_TOKEN_EXPIRATION=15m
REFRESH_TOKEN_SECRET=paygate-refresh-token-secret-example-change-in-prod
REFRESH_TOKEN_EXPIRATION=30d

# ------------------------------------------------------------------------------
# Payment Processors (Stripe SDK + Dummy Simulator)
# ------------------------------------------------------------------------------
# Dummy Simulator operates deterministically out-of-the-box (no Stripe key needed).
# To test real Stripe SDK in test mode, supply your pk_test and sk_test keys below:
STRIPE_SECRET_KEY=sk_test_placeholder_or_dummy
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# ------------------------------------------------------------------------------
# Base URLs & CORS Security
# ------------------------------------------------------------------------------
# Webhook dispatcher base URL for callbacks & built-in sandbox receiver
WEBHOOK_BASE=http://localhost:3000

# Frontend URL & allowed CORS origins (comma-separated for dev)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
